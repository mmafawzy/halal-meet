{
  "expo": {
    "name": "Halal Meet",
    "slug": "halal-meet",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "halalmeet",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.halalmeet.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.halalmeet.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Halal Meet",
      "themeColor": "#0F1B2D",
      "backgroundColor": "#FBF7F0"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      ["expo-notifications", { "color": "#0F1B2D", "defaultChannel": "default" }],
      ["expo-localization", { "supportsRTL": true }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Halal Meet uses your photos so you can add a profile picture. You control who can see it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7F0",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "extra": {
      "billing": {
        "revenuecatIosKey": null,
        "revenuecatAndroidKey": null,
        "offering": "default",
        "products": {}
      }
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}

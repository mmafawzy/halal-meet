# Halal Meet API — environment variables. Set them in your hosting platform (or your shell / docker compose);
# the API reads process.env and does not load a .env file. Never commit real values.
# Only JWT_SECRET is required to boot in production; each section says what else a real launch needs.

# ─── Core ───────────────────────────────────────────────────────────────────
NODE_ENV=development            # production: disables the dev OTP code and the dev billing grant
PORT=3000
JWT_SECRET=change-me            # REQUIRED in production: long random string; also signs photo URLs
PUBLIC_API_URL=                 # e.g. https://api.halalmeet.app — base for photo URLs behind a proxy/CDN

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=                   # postgres://user:pass@host:5432/db — production. Empty = embedded PGlite
PGLITE_DIR=.data/pglite         # PGlite data dir when DATABASE_URL is empty; "memory" = in-memory
MIGRATIONS_DIR=                 # override where drizzle migrations live (default: apps/api/drizzle)

# ─── Sign-in codes (OTP) ────────────────────────────────────────────────────
OTP_PROVIDER=dev                # dev (fixed 000000, never in production) | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=      # Twilio Verify service (enable SMS, and WhatsApp if wanted)

# ─── Realtime (several API instances) ───────────────────────────────────────
REDIS_URL=                      # redis://… — required when running more than one API instance

# ─── Photos ─────────────────────────────────────────────────────────────────
PHOTO_STORAGE=local             # local | memory | s3
PHOTO_DIR=.data/photos          # local driver only
S3_BUCKET=                      # s3: private bucket
S3_REGION=us-east-1             # "auto" for Cloudflare R2
S3_ENDPOINT=                    # omit for AWS; e.g. https://<account>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=               # omit both keys to use the default AWS credential chain (IAM role)
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false       # true for MinIO
S3_PREFIX=                      # optional key prefix, e.g. photos/
PHOTO_PENDING_VISIBLE=          # show photos awaiting moderation to others (default: true except production)

# ─── Notifications ──────────────────────────────────────────────────────────
EXPO_ACCESS_TOKEN=              # enables real pushes via Expo
PUSH_DRIVER=                    # expo | log (default: expo when EXPO_ACCESS_TOKEN is set)
NOTIFICATION_SCHEDULER=on       # off disables the 1-minute scheduler on this instance (a Postgres lock already
                                # ensures only one instance runs each pass)

# ─── Store billing (RevenueCat) ─────────────────────────────────────────────
REVENUECAT_WEBHOOK_SECRET=      # exact Authorization header value configured on the RevenueCat webhook
REVENUECAT_API_KEY=             # optional v1 secret key: enables POST /billing/sync
REVENUECAT_API_URL=https://api.revenuecat.com/v1
BILLING_PRODUCT_IDS=            # optional JSON overrides of store product ids, e.g. {"plus_monthly":{"ios":"…"}}
ANDROID_PACKAGE_NAME=app.halalmeet.mobile

# ─── Product rules ──────────────────────────────────────────────────────────
COUNTRY_STATUS_OVERRIDES=       # e.g. EG:open,SA:open,JO:growing
DELETION_GRACE_DAYS=30          # days before a requested account deletion is purged
